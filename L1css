/* CSS Lesson 1: Basic Syntax and Selectors */

/* Element Selector */
body {
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 20px;
}

/* Class Selector (starts with .) */
.title {
    color: #333;
    font-size: 24px;
    text-align: center;
}

/* ID Selector (starts with #) */
#main-content {
    background-color: #f0f0f0;
    padding: 15px;
    border-radius: 5px;
}

/* Multiple Selectors */
h1, h2, h3 {
    color: #2c3e50;
    margin-bottom: 10px;
}

/* Nested Selector */
div p {
    line-height: 1.6;
    color: #666;
}

/* Hover Effect */
.button {
    background-color: #3498db;
    color: white;
    padding: 10px 20px;
    border: none;
    cursor: pointer;
    transition: background-color 0.3s;
}

.button:hover {
    background-color: #2980b9;
}